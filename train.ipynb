import os
import tensorflow as tf
from tensorflow.keras.preprocessing.image import ImageDataGenerator
from tensorflow.keras.applications.mobilenet_v2 import MobileNetV2, preprocess_input
from tensorflow.keras.layers import Dense, GlobalAveragePooling2D, Dropout
from tensorflow.keras.models import Model

DATASET_PATH = '/kaggle/input/garbage-classification/garbage_classification/'

# 1. Set up Data Generators for ALL 12 folders
train_generator = ImageDataGenerator(
    preprocessing_function=preprocess_input,
    validation_split=0.2,
    rotation_range=20,
    width_shift_range=0.2,
    height_shift_range=0.2,
    horizontal_flip=True
)

# Using flow_from_directory automatically detects all 12 sub-folders
train_data = train_generator.flow_from_directory(
    DATASET_PATH,
    target_size=(224, 224),
    batch_size=32,
    class_mode='categorical', # Changed from binary
    subset='training'
)

val_data = train_generator.flow_from_directory(
    DATASET_PATH,
    target_size=(224, 224),
    batch_size=32,
    class_mode='categorical', # Changed from binary
    subset='validation'
)

# Print the exact class dictionary so you have it for your live script
class_indices = train_data.class_indices
label_map = {v: k for k, v in class_indices.items()}
print("\nYOUR NEW 12-CLASS DICTIONARY:")
print(label_map, "\n")

# 2. Build the 12-Class Model
base_model = MobileNetV2(weights='imagenet', include_top=False, input_shape=(224, 224, 3))
base_model.trainable = False

x = base_model.output
x = GlobalAveragePooling2D()(x)
x = Dense(128, activation='relu')(x)
x = Dropout(0.3)(x)
# 12 output nodes instead of 1, using 'softmax' to get probabilities for all 12
predictions = Dense(12, activation='softmax')(x)

model = Model(inputs=base_model.input, outputs=predictions)

# Compile using categorical crossentropy
model.compile(optimizer=tf.keras.optimizers.Adam(learning_rate=0.001),
              loss='categorical_crossentropy',
              metrics=['accuracy'])

# 3. Train the model
# Note: 12 classes is much harder to learn than 2. You might need 15-20 epochs for high accuracy.
epochs = 15 
history = model.fit(
    train_data,
    validation_data=val_data,
    epochs=epochs
)

# 4. Save the new model
model_filename = 'waste_classifier_12classes.keras'
model.save(model_filename)
print(f"Model saved successfully as '{model_filename}'")
